@using Scraper.Core
@using Scraper.Core.Dtos
@using Scraper.Core.Enums
@rendermode InteractiveServer

@if (visible && working != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="overflow-y:auto;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Page: @working.Name</h5>
                    <button class="btn-close" @onclick="OnCancelClicked"
                            disabled="@isActionOverlayOpen"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Name</label>
                            <input class="form-control" @bind="working.Name" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">URL</label>
                            <div class="input-group">
                                <input class="form-control"
                                       placeholder="https://pearsons.com/properties/auctions"
                                       @bind="working.Url" />
                                <button class="btn btn-outline-secondary"
                                        @onclick="OnReloadActions"
                                        disabled="@isReloading || isActionOverlayOpen"
                                        title="Reload actions with current URL">
                                    @(isReloading ? "Reloading..." : "Reload Actions")
                                </button>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <h6 class="mb-2">Actions</h6>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Action Type</label>
                            <select class="form-select form-select-sm"
                                    @bind="newActionType">
                                @foreach (var t in Enum.GetValues<ActionType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Target (Field)</label>
                            <select class="form-select form-select-sm"
                                    @bind="newActionFieldName">
                                <option value="">-- select field --</option>
                                @foreach (var f in TempFields.All)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary btn-sm"
                                    @onclick="ConfirmCreateAction"
                                    disabled="@(string.IsNullOrEmpty(newActionFieldName) || isActionOverlayOpen)">
                                Create Action
                            </button>
                        </div>
                    </div>

                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ActionType</th>
                                <th>Target</th>
                                <th style="width: 1%; white-space: nowrap;">Edit</th>
                                <th style="width: 1%; white-space: nowrap;">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (working.Actions.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted">No actions yet</td></tr>
                            }
                            else
                            {
                                @for (int i = 0; i < working.Actions.Count; i++)
                                {
                                    var idx = i;
                                    var a = working.Actions[idx];
                                    <tr>
                                        <td>@a.ActionType</td>
                                        <td>@(string.IsNullOrEmpty(a.FieldName) ? "(not set)" : a.FieldName)</td>
                                        <td>
                                            <button class="btn btn-link p-0"
                                                    @onclick="() => OnEditActionClicked(idx)">edit</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-danger btn-sm"
                                                    @onclick="() => OnDeleteActionClicked(idx)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="OpenPreview"
                                disabled="@(isActionOverlayOpen || working.Actions.Count == 0)">
                            Preview
                        </button>
                        <button class="btn btn-success btn-sm"
                                @onclick="OnSaveClicked"
                                disabled="@isActionOverlayOpen">
                            Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (selectedActionIndex.HasValue && selectedAction != null)
    {
        <EditActionOverlay ActionIndex="selectedActionIndex.Value"
                           Action="selectedAction"
                           PageUrl="@working.Url"
                           OnClose="OnActionOverlayClosed"
                           OnApplied="OnActionApplied" />
    }
}

@if (isPreviewOpen)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1061; overflow-y: auto;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Preview: @working?.Name</h5>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="RefreshPreview"
                                disabled="@isPreviewLoading">
                            @(isPreviewLoading ? "Loading..." : "Refresh")
                        </button>
                        <button class="btn-close" @onclick="ClosePreview"></button>
                    </div>
                </div>
                <div class="modal-body">
                    @if (isPreviewLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="mt-2 text-muted small">Fetching HTML and parsing...</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(previewError))
                    {
                        <div class="alert alert-danger">@previewError</div>
                    }
                    else if (previewResults.Count == 0)
                    {
                        <div class="text-muted text-center py-4">No results</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 180px;">Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in TempFields.All)
                                    {
                                        <tr>
                                            <td class="fw-bold">@field</td>
                                            <td>
                                                @if (previewResults.TryGetValue(field, out var val))
                                                {
                                                    <span title="@val">@val</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
