@page "/"
@rendermode InteractiveServer

<div class="container-fluid py-4">
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary" @onclick="OnAddClicked">Add</button>
    </div>

    <div class="row g-2 mb-3">
        <div class="col">
            <input class="form-control" placeholder="Search by name..." @oninput="OnNameSearchChanged" @bind="nameFilter" />
        </div>

        <div class="col">
            <input class="form-control" placeholder="Search by link..." @oninput="OnLinkSearchChanged" @bind="linkFilter" />
        </div>

    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col" style="cursor:pointer; user-select: none" @onclick='() => OnSortClicked("Name")'>
                    Name <i class="bi @SortIcon("Name")"></i></th>
                <th scope="col" style="cursor:pointer; user-select:none" @onclick='() => OnSortClicked("Link")'>
                    Link <i class="bi @SortIcon("Link")"></i></th>
            </tr>
        </thead>
        <tbody>
            @if (sources.Count == 0)
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No sources yet</td>
                </tr>
            }
            else
            {
                @foreach (var s in sources)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.Link</td>
                        <td><a href="@($"/Sources/{s.Id}")">edit</a></td>
                        <td><button type="button" class="btn btn-danger" @onclick="() => OnDeleteClicked(s.Id)">Delete</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center">
            @for (int p = 1; p <= totalPages; p++)
            {
                var pageNum = p;
                <button class="btn @(pageNum == PagingParams.Page ? "btn-primary" : "btn-outline-primary") btn-sm mx-1"
                @onclick='() => GoToPage(pageNum)'>@pageNum</button>
            }
        </div>
    }

    @if (isModalOpen)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">New source</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <EditForm Model="model" OnValidSubmit="SaveSource">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="nameInput" class="form-label">Name</label>
                                <InputText id="nameInput" class="form-control" @bind-Value="model.Name" />
                                <ValidationMessage For="() => model.Name" class="invalid-feedback d-block" />
                            </div>
                            <div class="mb-3">
                                <label for="linkInput" class="form-label">Link</label>
                                <InputText id="linkInput" class="form-control" @bind-Value="model.Link" />
                                <ValidationMessage For="() => model.Link" class="invalid-feedback d-block" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>