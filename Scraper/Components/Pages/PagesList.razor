@using Scraper.Core.Dtos
@using Scraper.Services
<div class="mb-3">
    <div class="d-flex justify-content-end">
        <button class="btn btn-primary" @onclick="OpenCreateModal">Create Page</button>
    </div>
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 1%; white-space: nowrap;"></th>
                <th>Name</th>
                <th>Url</th>
                <th style="width: 1%; white-space: nowrap;">Edit</th>
                <th style="width: 1%; white-space: nowrap;">Delete</th>
            </tr>
        </thead>
        <tbody>
            @if (pages.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No pages yet</td></tr>
            }
            else
            {
                @foreach (var (pid, page) in pages)
                {
                    <tr class="page-row" @onclick="() => ToggleAccordion(pid)"
                        style="cursor: pointer;">
                        <td>
                            <i class="bi @(expandedPageId == pid ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        </td>
                        <td>@(page.Name)</td>
                        <td>@(page.Url)</td>
                        <td>
                            <button class="btn btn-link p-0"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => OnPageSelected.InvokeAsync(pid)">edit</button>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => DeletePage(pid)">Delete</button>
                        </td>
                    </tr>
                    @if (expandedPageId == pid)
                    {
                        <tr class="accordion-row">
                            <td colspan="5" class="p-0">
                                <div class="accordion-body bg-light border-top p-3">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-4">
                                            <label class="form-label small text-muted">Name</label>
                                            <input class="form-control form-control-sm"
                                                   @bind="editingName" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label small text-muted">URL</label>
                                            <input class="form-control form-control-sm"
                                                   placeholder="https://example.com"
                                                   @bind="editingUrl" />
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="CancelAccordion">Cancel</button>
                                        <button class="btn btn-success btn-sm"
                                                @onclick="() => SaveAccordion(pid)">Save</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
@if (isCreateOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New page</h5>
                    <button class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="newName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL</label>
                        <input class="form-control" placeholder="https://pearsons.com/properties/auctions"
                               @bind="newUrl" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmCreate">Save</button>
                </div>
            </div>
        </div>
    </div>
}
