@page "/Sources/{Id:int}"
@rendermode InteractiveServer
<div class="container-fluid py-4">
    @if (source == null)
    {
        <div class="alert alert-warning">Source not found.</div>
        <a href="/" class="btn btn-secondary">Back</a>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-0">@source.Name</h3>
                <small class="text-muted">@source.Link</small>
            </div>
            <a href="/" class="btn btn-outline-secondary btn-sm">Back to sources</a>
        </div>
        <PagesList SourceId="source.Id" />
    }
</div>
